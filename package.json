{
  "name": "dsh-model-deploy",
  "version": "0.1.0",
  "description": "Local or remote AI model deployment benchmarking for real hardware targets",
  "type": "module",
  "license": "MIT",
  "author": "Ethan Zhao",
  "homepage": "https://github.com/ethanrise/dsh-model-deploy#readme",
  "bugs": {
    "url": "https://github.com/ethanrise/dsh-model-deploy/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanrise/dsh-model-deploy.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "onnx",
    "benchmark",
    "deployment",
    "ssh",
    "edge-ai"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.5-alpha.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-model-deploy-mcp": "./lib/server.js",
    "dsh-model-deploy-doctor": "./lib/doctor.js"
  },
  "files": [
    "lib",
    "dsh_model_deploy",
    "skills",
    "cordis.patch.yml",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts src/doctor.ts --bundle --platform=node --format=esm --target=node22 --outdir=lib --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-alpha.1",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.1.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  }
}
